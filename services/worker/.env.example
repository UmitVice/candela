# Candela worker configuration. Copy to services/worker/.env (git-ignored); `make worker-connect` and
# `make worker-serve` export it. Never commit the token.

# Worker protocol (candela.worker.v1). The gateway serves worker connect on its internal listener.
CANDELA_WORKER_URL=ws://127.0.0.1:8719/api/v1/worker/connect
# Same value as the gateway's CANDELA_WORKER_TOKEN (services/gateway/bin/workerctl token -env services/gateway/.env).
CANDELA_WORKER_TOKEN=
# Generic id; the gateway shows an opaque session id publicly. Never use the hostname or user name.
CANDELA_WORKER_ID=candela-worker
# Comma-separated model ids from served-models.yaml (default: its `default`).
CANDELA_WORKER_MODEL=candela-pro-v0.1
# CANDELA_WORKER_DEVICE=Apple M5 Pro · 24 GB     # override the detected chip and memory label

# Model paths (defaults come from ml/configs/models.yaml and served-models.yaml)
# CANDELA_PRO_BASE=~/models/gemma-4-12b-it-qat-mlx-q4
# CANDELA_PRO_ADAPTER=ml/runs/candela-pro-v0.1-lr5e5/adapter
# CANDELA_PRO_PILOT_ADAPTER=ml/runs/pilot-candela-pro/adapter

# Resources
CANDELA_WORKER_IDLE_UNLOAD_SEC=900
# How long a job may wait for memory headroom (lower-priority trainers release the GPU meanwhile).
CANDELA_WORKER_ADMISSION_WAIT_SEC=30
# Headroom kept free on top of the model's inference budget.
CANDELA_WORKER_RESERVE_GB=1.0
CANDELA_WORKER_MAX_PROMPT_TOKENS=16384
CANDELA_WORKER_PREFILL_CHUNK=256
# 8-bit KV cache for full-attention layers beyond CANDELA_WORKER_KV_START tokens (0 = off; see ADR 0300).
CANDELA_WORKER_KV_BITS=0
CANDELA_WORKER_KV_START=4096
CANDELA_WORKER_PROMPT_CACHE_ENTRIES=4
CANDELA_WORKER_PROMPT_CACHE_MB=1024
CANDELA_WORKER_MLX_CACHE_MB=512
# Telemetry frames per second while the Observatory asks for them (capped at the contract's 20).
CANDELA_WORKER_TELEMETRY_FPS=18
# CANDELA_LEASE_DIR=~/.candela/leases

# Development HTTP API (`candela-worker serve`, 127.0.0.1 only; refused when CANDELA_ENV=production)
CANDELA_WORKER_HTTP_PORT=8711
CANDELA_ENV=development
CANDELA_LOG_LEVEL=info
