# Candela gateway configuration. Copy to services/gateway/.env (git-ignored) and adjust.
# Paths are relative to the repository root, where `make gateway-run` starts the binary.

# Listeners. The internal listener (tool API, metrics, worker connect) must never be tunnelled.
CANDELA_ADDR=127.0.0.1:8710
CANDELA_INTERNAL_ADDR=127.0.0.1:8719
# PORT=8080                      # when set (containers), the public listener binds 0.0.0.0:$PORT
CANDELA_ENV=development
CANDELA_LOG_LEVEL=info

# Storage
CANDELA_DB_PATH=services/gateway/data/gateway.sqlite
CANDELA_SNAPSHOT_PATH=services/gateway/data/market.sqlite
# CANDELA_SNAPSHOT_URL=https://example.org/market.sqlite   # download a prebuilt snapshot when the file is missing

# Edge and CORS
CANDELA_ALLOWED_ORIGINS=http://localhost:4200,https://candela-terminal.netlify.app
# cloudflare: client IP from CF-Connecting-IP; xff: from X-Forwarded-For; empty: socket address.
# Headers are trusted only when the socket peer is inside CANDELA_TRUSTED_PROXY_CIDRS.
CANDELA_TRUSTED_PROXY=
CANDELA_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Secrets: generate with `openssl rand -base64 32` (or `services/gateway/bin/workerctl token -env services/gateway/.env`).
CANDELA_WORKER_TOKEN=
CANDELA_METRICS_TOKEN=
CANDELA_WORKER_ON_PUBLIC=false

# Fallback upstream: a development and future-cloud adapter for any OpenAI-compatible server
# (`make gateway-lite-up` runs a small dev GGUF with llama-server on 8712). Empty = on in
# development, off in production; true/false forces it.
CANDELA_FALLBACK_ENABLED=
CANDELA_FALLBACK_URL=http://127.0.0.1:8712/v1
CANDELA_FALLBACK_API_KEY=
CANDELA_FALLBACK_MODEL=qwen3-1.7b
CANDELA_FALLBACK_MODEL_ID=qwen3-1.7b-base
# CANDELA_FALLBACK_MODEL_INFO={"id":"candela-1.7b-v0.1","displayName":"Candela 1.7B",...}   # full ModelInfo JSON override
CANDELA_FALLBACK_CONCURRENCY=1
CANDELA_FALLBACK_TIMEOUT=120s

# Generation limits. 0 = one slot per worker (its maxConcurrency) plus the fallback concurrency.
CANDELA_MAX_CONCURRENT_GENERATIONS=0
CANDELA_QUEUE_MAX_DEPTH=16
CANDELA_CHAT_TIMEOUT=300s
CANDELA_TOOL_TIMEOUT=8s
CANDELA_SHUTDOWN_TIMEOUT=30s
# Prompt and output caps: client history is trimmed (oldest first) to CANDELA_MAX_INPUT_CHARS
# before generation; tool rounds stop once the whole prompt exceeds CANDELA_MAX_CONTEXT_CHARS;
# completion tokens across all rounds are capped by CANDELA_MAX_OUTPUT_TOKENS.
CANDELA_MAX_INPUT_CHARS=24000
CANDELA_MAX_CONTEXT_CHARS=64000
CANDELA_MAX_OUTPUT_TOKENS=2048
# Soft Go heap limit (an explicit GOMEMLIMIT wins); 0 disables it.
CANDELA_MEMORY_LIMIT=512MiB

# Rate limits per client IP
CANDELA_RATE_CHAT_PER_MIN=6
CANDELA_RATE_CHAT_BURST=3
CANDELA_RATE_MARKET_PER_MIN=60
CANDELA_RATE_MARKET_BURST=20
CANDELA_RATE_FEEDBACK_PER_MIN=20
CANDELA_RATE_FEEDBACK_BURST=5

# Market data
CANDELA_SYMBOLS_BASE_URL=https://www.nasdaqtrader.com/dynamic/SymDir
CANDELA_SYMBOLS_REFRESH=24h
CANDELA_DISABLE_SYMBOL_FETCH=false
CANDELA_MARKET_CACHE_TTL=1h
# Outbound market-data requests: HTTPS only, these hosts only, public addresses only (after DNS).
CANDELA_EGRESS_ALLOW=www.nasdaqtrader.com,huggingface.co,*.huggingface.co,*.hf.co
# Optional providers (adapters are disabled until implemented and configured)
SEC_USER_AGENT=
CANDELA_LIVE_API_KEY=
CANDELA_VANIRAS_URL=

# Owner-only: record successful chats as replayable sessions (contain conversation text)
CANDELA_RECORD_SESSIONS=false
CANDELA_RECORDINGS_DIR=services/gateway/data/recordings

# cmd/fakeworker
CANDELA_WORKER_URL=ws://127.0.0.1:8719/api/v1/worker/connect
