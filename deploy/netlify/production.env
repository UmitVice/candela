# Inputs for `make live-web-deploy` (apps/web/scripts/render-dist.mjs). WEB_DISCOVERY_URL comes
# from deploy/local/endpoint.json; render-dist then adds its origin and *.trycloudflare.com
# (https and wss) to the CSP connect-src.
WEB_MODE=auto
WEB_CHAT_TRANSPORT=ws
WEB_ENVIRONMENT=production
WEB_CONNECT_SRC_EXTRA="https://api.github.com https://huggingface.co https://*.hf.co"
