# Candela live stack (make live-up). Copy to deploy/.env (git-ignored, chmod 600) or run
# `make live-tokens`, which fills both tokens with `openssl rand -base64 32`. Never commit deploy/.env.
# The edge supervisor reads this file itself; variables already set in the environment win.
CANDELA_WORKER_TOKEN=
CANDELA_METRICS_TOKEN=

# Served model (services/worker/served-models.yaml). The worker reads only the directories in
# CANDELA_EDGE_WORKER_READ (at most 6, read-only inside its sandbox).
# CANDELA_WORKER_MODEL=candela-pro-v0.1
# CANDELA_PRO_ADAPTER=ml/runs/candela-pro-v0.1-lr5e5/adapter
# CANDELA_EDGE_WORKER_READ=~/models/gemma-4-12b-it-qat-mlx-q4,ml/runs/candela-pro-v0.1-lr5e5/adapter
CANDELA_WORKER_IDLE_UNLOAD_SEC=900
CANDELA_LOG_LEVEL=info

# Gateway limits (defaults in services/gateway/.env.example). The supervisor forces production
# mode, loopback listeners, CANDELA_TRUSTED_PROXY=cloudflare and no fallback upstream.
CANDELA_RATE_CHAT_PER_MIN=6
CANDELA_RATE_CHAT_BURST=3
CANDELA_QUEUE_MAX_DEPTH=8
CANDELA_MAX_OUTPUT_TOKENS=2048
# Owner-only: record chats as replay sessions under services/gateway/data/live/recordings.
CANDELA_RECORD_SESSIONS=false

# Kill switch: rejections per window that close the tunnel for the cooldown.
CANDELA_EDGE_KILL_WINDOW=2m
CANDELA_EDGE_KILL_COOLDOWN=15m
CANDELA_EDGE_KILL_MAX_TRIPS=3
CANDELA_EDGE_KILL_RATE_LIMITED=300
CANDELA_EDGE_KILL_OVERSIZED=30
CANDELA_EDGE_KILL_ORIGIN=120
CANDELA_EDGE_KILL_PROTOCOL=60
CANDELA_EDGE_KILL_INVALID=300
CANDELA_EDGE_HEARTBEAT=10m
