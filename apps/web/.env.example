# Candela web has no secrets. These variables are read by `make web-render` / `make web-deploy`
# to write dist/config.json and the CSP connect-src; nothing is compiled into the bundle.
WEB_MODE=replay
WEB_CHAT_TRANSPORT=ws
WEB_API_BASE_URL=
WEB_DISCOVERY_URL=
WEB_ENVIRONMENT=production
WEB_RELEASE=
WEB_CONNECT_SRC_EXTRA=
WEB_PREVIEW_PORT=4210
